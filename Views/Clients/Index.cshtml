@model IEnumerable<AIClientManager.Models.Client>
@{
    Layout = "_Layout";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa fa-check-circle"></i>
        @TempData["Success"]
    </div>
}



<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Client Management</h2>
    <a href="/Clients/Create" class="btn btn-primary">
        <i class="fa fa-plus"></i> New Client
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <!-- ✅ ICI : bouton Export PDF -->
       


        <form asp-action="ReAnalyzeAll"
            method="post"
            class="d-inline"
            onsubmit="return confirm('Re-analyze all clients with AI?');">

            @Html.AntiForgeryToken()

            <button class="btn btn-outline-warning mb-3 ms-2">
                <i class="fa fa-robot"></i> Re-Analyze All
            </button>
        </form>


        <!-- Search -->
        <form method="get" class="row g-2 mb-4">

            <div class="col-md-3">
                <input name="company"
                    class="form-control"
                    placeholder="Company..." />
            </div>

            <div class="col-md-2">
                <select name="priority" class="form-select">
                    <option value="">All priorities</option>
                    <option>High</option>
                    <option>Medium</option>
                    <option>Low</option>
                </select>
            </div>

            <div class="col-md-2">
                <input name="minScore"
                    type="number"
                    class="form-control"
                    placeholder="Min score" />
            </div>

            <div class="col-md-2">
                <input name="maxScore"
                    type="number"
                    class="form-control"
                    placeholder="Max score" />
            </div>

            <div class="col-md-2">
                <button class="btn btn-outline-primary w-100">
                    <i class="fa fa-filter"></i> Filter
                </button>
            </div>

        </form>


        <!-- Table -->
        @if (!Model.Any())
            {
                <div class="text-center text-muted p-4">
                    <i class="fa fa-users fa-2x mb-2"></i>
                    <p>No clients yet. Start by adding one.</p>
                </div>
            }
        else
            {
                <table class="table table-hover align-middle clients-table">

                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Score</th>
                            <th>AI Summary</th>
                            <th>Keywords</th>
                            <th>Priority</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                
                        

                    @foreach (var c in Model)
                    {

                        <tr>
                            <td>@c.Name</td>
                            <td>@c.Company</td>
                            <td>@c.Email</td>

                            <td>
                                <div class="fw-bold">@c.Score</div>
                                <div class="progress mt-1" style="height:6px;">
                                    <div class="progress-bar 
                                        @(c.Score >= 70 ? "bg-danger" :
                                        c.Score >= 40 ? "bg-warning" :
                                        "bg-success")"
                                        style="width:@c.Score%">
                                    </div>
                                </div>
                            </td>

                            <td>
                                <small class="text-muted">@c.Summary</small>
                            </td>

                            <td>
                                @foreach (var k in (c.Keywords ?? "")
                                    .Split(",", StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-secondary me-1">@k</span>
                                }
                            </td>

                            <td>
                                <span class="badge 
                                    @(c.Priority == "High" ? "bg-danger" :
                                    c.Priority == "Medium" ? "bg-warning text-dark" :
                                    "bg-success")">
                                    @c.Priority
                                </span>
                            </td>

                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-info"
                                href="/Clients/History/@c.Id">
                                    <i class="fa fa-chart-line"></i>
                                </a>

                                <a class="btn btn-sm btn-outline-secondary"
                                href="/Clients/ExportPdf/@c.Id">
                                    <i class="fa fa-file-pdf"></i>
                                </a>
                                <a class="btn btn-sm btn-outline-primary" href="/Clients/Edit/@c.Id">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <a class="btn btn-sm btn-outline-danger" href="/Clients/Delete/@c.Id">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                }
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

                </tbody>
            </table>
        
            }
    </div>
</div>
