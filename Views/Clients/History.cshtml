@model List<AIClientManager.Models.ClientAnalysisHistory>

@{
    Layout = "_Layout";
    var client = ViewBag.Client as AIClientManager.Models.Client;
}

<h2>Score History — @client?.Name</h2>

<a href="/Clients" class="btn btn-secondary mb-3">
    ← Back
</a>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <canvas id="historyChart"></canvas>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Score</th>
            <th>Priority</th>
            <th>Keywords</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>@h.AnalyzedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@h.Score</td>
                <td>@h.Priority</td>
                <td>@h.Keywords</td>
            </tr>
        }
    </tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Select(m => m.AnalyzedAt.ToString("MM-dd HH:mm"))
));

const scores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Select(m => m.Score)
));

new Chart(document.getElementById('historyChart'), {
    type: 'line',
    data: {
        labels: labels,
        datasets: [{
            label: 'Score Evolution',
            data: scores,
            tension: 0.3,
            fill: true
        }]
    }
});
</script>
